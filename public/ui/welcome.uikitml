<!--
  WeaVR welcome panel — the first thing users see on launch.
  Lucide icons: RectangleGoggles, LogIn, Mic.
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 500px;
    border-radius: 18px;
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.08);
  }

  .panel-content {
    flex-direction: column;
    gap: 10px;
    padding: 28px;
    align-items: center;
  }

  .brand {
    color: #94A3B8;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 3px;
  }

  .brand:dark {
    color: #94A3B8;
  }

  .heading {
    color: #1c1d20;
    font-size: 26px;
    font-weight: 600;
    line-height: 32px;
    text-align: center;
  }

  .heading:dark {
    color: #fafaf7;
  }

  .suggestion {
    color: #64748B;
    font-size: 14px;
    line-height: 20px;
    text-align: center;
  }

  .suggestion:dark {
    color: #94A3B8;
  }

  .guide-chip {
    color: #E2E8F0;
    font-size: 12px;
    font-weight: 500;
    text-align: center;
    background-color: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.1);
    border-width: 1px;
    border-radius: 8px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 6px;
    padding-bottom: 6px;
    margin-top: 4px;
  }

  .guide-chip:dark {
    color: #E2E8F0;
    background-color: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.1);
  }

  .button-row {
    flex-direction: row;
    gap: 12px;
    justify-content: center;
    margin-left: 24px;
    margin-right: 24px;
    margin-bottom: 20px;
    margin-top: 20px;
  }

  .btn {
    justify-content: flex-start;
  }

  .btn-label {
    transform-translate-y: 1px;
  }

  .listening-indicator {
    color: #38BDF8;
    font-size: 13px;
    font-weight: 600;
    text-align: center;
    display: none;
    margin-top: 2px;
  }

  .listening-indicator:dark {
    color: #38BDF8;
  }
</style>
<Panel class="panel-root" id="welcome-root">
  <div class="panel-content">
    <div class="brand">WEAVR</div>
    <div class="heading">Weave Anything.</div>
    <div class="guide-chip">Tip: Pinch &amp; drag connector ends to link workflows</div>
    <div id="listening-text" class="listening-indicator">Connecting...</div>
  </div>
  <div class="button-row">
    <Button id="xr-button" class="btn">
      <ButtonIcon>
        <RectangleGoggles></RectangleGoggles>
      </ButtonIcon>
      <ButtonLabel class="btn-label">Enter XR</ButtonLabel>
    </Button>
    <Button id="mic-button" class="btn">
      <ButtonIcon>
        <Mic></Mic>
      </ButtonIcon>
      <ButtonLabel id="mic-label" class="btn-label">Voice Agent</ButtonLabel>
    </Button>
  </div>
  <Button id="exit-button" class="btn" style="display: none; margin-left: 24px; margin-right: 24px; margin-bottom: 20px">
    <ButtonIcon>
      <LogIn></LogIn>
    </ButtonIcon>
    <ButtonLabel class="btn-label">Exit to Browser</ButtonLabel>
  </Button>
</Panel>
